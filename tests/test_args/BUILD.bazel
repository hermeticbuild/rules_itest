load("@rules_go//go:def.bzl", "go_test")
load("@rules_itest//:itest.bzl", "itest_service_group", "named_port", "named_port_alias", "port", "port_alias", "service_test")

itest_service_group(
    name = "test_args",
    hygienic = False,
    port_aliases = {"http": port_alias("//:autoassigned")},
    services = ["//:autoassigned"],
)

itest_service_group(
    name = "outer",
    hygienic = False,
    port_aliases = {"": named_port_alias("//test_args", "http")},
    services = [":test_args"],
)

go_test(
    name = "_args_test",
    srcs = ["args_test.go"],
    tags = ["manual"],
)

service_test(
    name = "args_test",
    services = [":outer"],
    test = ":_args_test",
    args = [
        "--test-arg=hello",
        "--test-port=" + port(":outer"),
        "--named-port=" + named_port("//test_args", "http"),
    ],
)
