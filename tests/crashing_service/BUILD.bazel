load("@rules_go//go:def.bzl", "go_binary")
load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("//:must_fail.bzl", "must_fail_test")

itest_service(
    name = "crashing_service",
    args = [
        "-port",
        "$${PORT}",
        "-die-after",
        "1s",
    ],
    autoassign_port = True,
    exe = "//go_service",
    http_health_check_address = "http://127.0.0.1:$${PORT}",
    hygienic = False,
)

must_fail_test(
    name = "crash_test",
    expected = "exited with error: exit status 1",
    test = "_crash_test",
)

service_test(
    name = "_crash_test",
    services = [
        ":crashing_service",
    ],
    tags = ["manual"],
    test = ":wait",
)

go_binary(
    name = "wait",
    srcs = ["wait.go"],
    tags = ["manual"],
)
