load("@rules_itest//:itest.bzl", "itest_service")
load("//:must_fail.bzl", "must_fail")
load("//:test_rules.bzl", "itest_go_test")

itest_service(
    name = "crashing_service",
    args = [
        "-port",
        "$${PORT}",
        "-die-after",
        "1s",
    ],
    autoassign_port = True,
    exe = "//go_service",
    http_health_check_address = "http://127.0.0.1:$${PORT}",
    hygienic = False,
)

must_fail(
    name = "crash_test",
    test = "_crash_test",
)

itest_go_test(
    name = "_crash_test",
    srcs = ["crash_test.go"],
    services = [
        ":crashing_service",
    ],
    tags = ["manual"],
)
