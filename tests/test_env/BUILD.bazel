load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_itest//:itest.bzl", "itest_task")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//:test_rules.bzl", "itest_go_test")

env = {
    "ITEST_ENV_VAR": "ITEST_ENV_VAR_VALUE",
    "ENV_RUNFILE": "$(rlocationpath :test.txt)",
}

itest_go_test(
    name = "env_specified_in_base",
    srcs = ["env_test.go"],
    data = [":test.txt"],
    env = env,
    deps = ["@rules_go//go/runfiles"],
)

itest_go_test(
    name = "env_specified_in_task",
    srcs = ["env_test.go"],
    data = [":test.txt"],
    env = env,
    services = [":task_sh"],
    deps = ["@rules_go//go/runfiles"],
)

cc_binary(
    name = "_task_cc",
    srcs = ["task.cc"],
    data = [
        ":test.txt",
    ],
    env = env,
)

itest_task(
    name = "task_cc",
    exe = ":_task_cc",
)

sh_binary(
    name = "_task_sh",
    srcs = ["task.sh"],
)

itest_task(
    name = "task_sh",
    data = [":test.txt"],
    env = env,
    exe = ":_task_sh",
)
